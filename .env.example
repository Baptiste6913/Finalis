# Copy to .env (same folder) and uncomment what you need. Nothing here is required:
# with no .env at all the server uses your Claude Code login through the `claude` CLI.

# Force the Anthropic API instead of the CLI (adds page images to the visual checks):
# ANTHROPIC_API_KEY=sk-ant-...

# Force a backend: cli (Claude Code login) | api (ANTHROPIC_API_KEY) | mock (no model)
# PRESCREEN_BACKEND=cli

# Models. Set these if your Claude account does not have the defaults.
# MODEL_COMPLEX=claude-opus-5
# MODEL_DEFAULT=claude-sonnet-5
# MODEL_QUICK=claude-haiku-4-5-20251001

# Port (default 8787) and binding. Keep LOCAL_ONLY=1 unless you put auth in front.
# PRESCREEN_PORT=8787
# PRESCREEN_LOCAL_ONLY=1
